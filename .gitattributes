* text=auto
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yar text eol=lf
*.yml text eol=lf
families/**/samples/** text eol=lf
unattributed/**/samples/** text eol=lf

# Preserve observed end-of-line spacing in samples. Generated family pages
# embed those samples verbatim, so their fenced examples carry the same spacing.
families/**/samples/** whitespace=-blank-at-eol
unattributed/**/samples/** whitespace=-blank-at-eol
families/**/README.md whitespace=-blank-at-eol
unattributed/**/README.md whitespace=-blank-at-eol
