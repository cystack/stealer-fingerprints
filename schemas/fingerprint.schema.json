{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cystack/stealer-fingerprints/main/schemas/fingerprint.schema.json",
  "title": "Immutable structural log-format fingerprint",
  "$comment": "tools/catalog.py applies semantic validation that JSON Schema cannot fully express, including normalization, privacy checks, signal strength, and filename safety.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "id", "family_id", "status", "scope", "sharing", "quality", "signature"],
  "properties": {
    "$schema": {"const": "../../../schemas/fingerprint.schema.json"},
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^fp_[0-9a-f]{32}$"},
    "family_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"const": "active"},
    "scope": {"const": "exported_log_format"},
    "sharing": {"const": "TLP:CLEAR"},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent_signal_types", "independent_signal_count", "yara_eligible"],
      "properties": {
        "independent_signal_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["marker", "field_keys", "filenames"]}
        },
        "independent_signal_count": {"type": "integer", "minimum": 1, "maximum": 3},
        "yara_eligible": {"type": "boolean"}
      }
    },
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "bannerSet": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\r\\n\\u0000]+$"}
    },
    "fieldSet": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^\\r\\n\\u0000]+$"}
    },
    "filenameSet": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9_ .()\\[\\]<>+-]+\\.(?:[tT][xX][tT]|[jJ][sS][oO][nN]|[lL][oO][gG]|[iI][nN][iI]|[cC][sS][vV])$"
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["panel_brand", "banner_strings", "field_keys", "filenames"],
      "properties": {
        "panel_brand": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "banner_strings": {"$ref": "#/$defs/bannerSet"},
        "field_keys": {
          "$ref": "#/$defs/fieldSet",
          "description": "Canonical case-folded structural labels."
        },
        "filenames": {
          "$ref": "#/$defs/filenameSet",
          "description": "Canonical case-insensitive basenames. Angle-bracket placeholders such as <locale> represent one non-empty dynamic segment. Runtime semantic validation permits at most eight non-adjacent placeholders; names start alphanumeric and continue with alphanumerics, underscore, or hyphen."
        }
      },
      "anyOf": [
        {
          "properties": {
            "panel_brand": {"type": "string"},
            "field_keys": {"minItems": 3}
          }
        },
        {
          "properties": {
            "banner_strings": {"minItems": 1},
            "field_keys": {"minItems": 3}
          }
        },
        {
          "properties": {
            "panel_brand": {"type": "null"},
            "banner_strings": {"maxItems": 0},
            "field_keys": {"minItems": 5},
            "filenames": {"minItems": 1}
          }
        }
      ]
    }
  }
}
