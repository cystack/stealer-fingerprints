{
  "id": "steal-c",
  "name": "StealC",
  "classification": "known_family",
  "attribution_confidence": "high",
  "description": "StealC info-stealer logs. Writes a sectioned `system_info.txt`\nwith header lines like `Network Info:`, `System Summary:`, and\ntab-indented `- Key: Value` records under each. First documented\nin early 2023, StealC has remained an active commodity stealer\nwith the v2 rewrite tracked through 2024.",
  "aliases": [
    "StealC v1",
    "StealC v2"
  ],
  "typical_targets": [
    "Browser saved credentials and cookies",
    "Crypto wallet extensions and desktop clients",
    "FTP, email, VPN, RDP client configs",
    "Discord and Telegram session data",
    "Custom file grabber configurable per-build"
  ],
  "detection_notes": "Distinctive sectioned layout with `Network Info:` and\n`System Summary:` parent headers and tab-indented field lines.\nDistributed via multiple Telegram resellers; the\n`@stealerboss` channel is one of the larger redistributors.",
