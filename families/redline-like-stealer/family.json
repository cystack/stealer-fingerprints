{
  "id": "redline-like-stealer",
  "name": "RedlineLike Stealer",
  "classification": "cystack_named",
  "attribution_confidence": "unknown",
  "description": "RedLine extended-block log variants. UserInformation.txt files\nemitting the canonical Redline `Operation System:` typo together\nwith the panel's identity, locale, and hardware fields. Several\nTelegram-based affiliate channels rebrand the same RedLine builder\nwith custom banners (DARKSIDE, ZAPLINE, and similar) while keeping\nthe underlying field layout intact.",
  "aliases": [
    "redline",
    "redline-extended"
  ],
  "typical_targets": [
    "Browser saved credentials (Chromium and Gecko families)",
    "Browser cookies and session storage",
    "Crypto-wallet desktop clients",
    "FTP and SSH client configs",
    "Discord and Telegram session tokens"
  ],
  "detection_notes": "Confidence triggers, in increasing order of certainty:\n\n1. Plain `Operation System:` field (note the typo) is suggestive\n   but matches several stripped-down clones.\n2. `Operation System:` plus the channel banner (e.g.\n   `===DARKSIDE_BRAND_BEGIN===`) is high-confidence RedLine.\n3. `Operation System:` plus `Admin Group:` plus `Integrity:` is\n   the unambiguous RedLine extended-block form.\n\nPair with browser-credential file paths (`Login Data`,\n`formhistory.sqlite`) and Discord token grabber output to confirm\nin incident-response triage.",
  "attack_techniques": [
    {
      "id": "T1555",
      "name": "Credentials from Password Stores"
    },
    {
      "id": "T1555.003",
      "name": "Credentials from Web Browsers"
    },
    {
      "id": "T1539",
      "name": "Steal Web Session Cookie"
    },
    {
      "id": "T1119",
      "name": "Automated Collection"
    },
    {
      "id": "T1005",
      "name": "Data from Local System"
    }
  ],
  "related_families": [
    "vidar",
    "meta-stealer"
  ],
  "sources": [
    "https://www.esentire.com/blog/esentire-threat-intelligence-malware-analysis-redline-stealer",
    "https://github.com/MalBeacon/what-is-this-stealer"
  ],
