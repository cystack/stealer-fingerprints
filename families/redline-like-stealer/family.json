{
  "id": "redline-like-stealer",
  "name": "RedlineLike Stealer",
  "classification": "cystack_named",
  "attribution_confidence": "unknown",
  "description": "RedLine extended-block log variants. UserInformation.txt files\nemitting the canonical Redline `Operation System:` typo together\nwith the panel's identity, locale, and hardware fields. Several\nTelegram-based affiliate channels rebrand the same RedLine builder\nwith custom banners (DARKSIDE, ZAPLINE, and similar) while keeping\nthe underlying field layout intact.",
  "aliases": [
    "redline",
    "redline-extended"
  ],
  "typical_targets": [
    "Browser saved credentials (Chromium and Gecko families)",
    "Browser cookies and session storage",
    "Crypto-wallet desktop clients",
    "FTP and SSH client configs",
    "Discord and Telegram session tokens"
  ],
  "detection_notes": "Confidence triggers, in increasing order of certainty:\n\n1. Plain `Operation System:` field (note the typo) is suggestive\n   but matches several stripped-down clones.\n2. `Operation System:` plus the channel banner (e.g.\n   `===DARKSIDE_BRAND_BEGIN===`) is high-confidence RedLine.\n3. `Operation System:` plus `Admin Group:` plus `Integrity:` is\n   the unambiguous RedLine extended-block form.\n\nPair with browser-credential file paths (`Login Data`,\n`formhistory.sqlite`) and Discord token grabber output to confirm\nin incident-response triage.",
  "attack_techniques": [
    {
      "id": "T1555",
      "name": "Credentials from Password Stores"
    },
    {
      "id": "T1555.003",
      "name": "Credentials from Web Browsers"
    },
    {
      "id": "T1539",
      "name": "Steal Web Session Cookie"
    },
    {
      "id": "T1119",
      "name": "Automated Collection"
    },
    {
      "id": "T1005",
      "name": "Data from Local System"
    }
  ],
  "related_families": [
    "vidar",
    "meta-stealer"
  ],
  "sources": [
    "https://www.esentire.com/blog/esentire-threat-intelligence-malware-analysis-redline-stealer",
    "https://github.com/MalBeacon/what-is-this-stealer"
  ],
  "localizations": {
    "vi": {
      "description": "Các biến thể log dạng khối mở rộng (extended-block) của RedLine. Tệp UserInformation.txt tạo dữ liệu đầu ra chứa lỗi đánh máy đặc trưng `Operation System:` của Redline cùng với các trường thông tin định danh, ngôn ngữ/vùng và phần cứng của bảng điều khiển. Một số kênh liên kết trên Telegram gắn thương hiệu riêng (DARKSIDE, ZAPLINE, và tương tự) lên cùng một builder RedLine, trong khi vẫn giữ nguyên bố cục trường dữ liệu gốc.",
      "typical_targets": [
        "Thông tin xác thực đã lưu trong trình duyệt (các họ Chromium và Gecko)",
        "Cookie trình duyệt và dữ liệu phiên lưu trữ",
        "Ứng dụng desktop ví tiền điện tử",
        "Cấu hình ứng dụng FTP và SSH",
        "Token phiên Discord và Telegram"
      ],
      "detection_notes": "Các mức độ tin cậy, theo thứ tự tăng dần:\n\n1. Trường `Operation System:` đơn thuần (lưu ý lỗi đánh máy) chỉ mang tính gợi ý và trùng khớp với nhiều bản sao đã bị lược bớt.\n2. `Operation System:` kết hợp với banner của kênh (ví dụ `===DARKSIDE_BRAND_BEGIN===`) cho độ tin cậy cao là RedLine.\n3. `Operation System:` kết hợp với `Admin Group:` và `Integrity:` là dạng khối mở rộng RedLine không thể nhầm lẫn.\n\nKết hợp với đường dẫn tệp thông tin xác thực trình duyệt (`Login Data`, `formhistory.sqlite`) và dữ liệu đầu ra của mô-đun thu thập token Discord để xác nhận trong quá trình phân loại ứng phó sự cố.",
      "attack_techniques": [
        {
          "id": "T1555",
          "name": "Thông tin xác thực từ kho mật khẩu"
        },
        {
          "id": "T1555.003",
          "name": "Thông tin xác thực từ trình duyệt web"
        },
        {
          "id": "T1539",
          "name": "Đánh cắp cookie phiên web"
        },
        {
          "id": "T1119",
          "name": "Thu thập tự động"
        },
        {
          "id": "T1005",
          "name": "Dữ liệu từ hệ thống cục bộ"
        }
      ]
    }
  },
