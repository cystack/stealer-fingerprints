  "name": "PXA Stealer",
  "classification": "known_family",
  "attribution_confidence": "high",
  "description": "PXA Stealer is a Vietnamese-origin info-stealer. Its\n`system_info.txt` uses a Vietnamese header\n(`Thông tin hệ thống`) and snake_case keys lifted from WMI /\nWin32 API names, making the fingerprint visually distinctive\neven before content matches.",
  "aliases": [
    "PXAStealer"
  ],
  "typical_targets": [
    "Browser saved credentials and cookies",
    "Crypto wallet extensions and desktop clients",
    "Telegram, Discord, Steam session tokens",
    "VPN and FTP client configurations",
    "Documents matching specific filename patterns"
  ],
  "detection_notes": "Vietnamese banner `Thông tin hệ thống` is unambiguous. Pair\nwith the snake_case key style (`computer_system`, `os`,\n`processor`, `bios`) to confirm.",
