{
  "id": "remus-stealer",
  "name": "Remus Stealer",
  "classification": "known_family",
  "attribution_confidence": "high",
  "description": "Remus Stealer is a 64-bit malware-as-a-service infostealer first\nobserved in 2026 and independently analyzed as closely related\nto Lumma. It is distributed via the `@rmsops` channel. The\n`Info.txt` opens with `# BUY STEALER - https://t.me/rmsops`\nfollowed by a `# REMUS LOG` banner and a YAML-style `build:`\nblock. Field shape parallels Lumma's dash-prefix list but with\na different banner and distribution channel.",
  "aliases": [
    "Remus"
  ],
  "typical_targets": [
    "Browser saved credentials and cookies",
    "Crypto wallet extensions and clients",
    "System hardware and locale inventory"
  ],
  "detection_notes": "The `# REMUS LOG` banner together with the `@rmsops` channel\nreference is unambiguous. The YAML-shaped `build:` opening\nalso distinguishes Remus from Lumma proper, which uses the\ndash-prefix `- LummaC2 Build:` form instead.",
  "attack_techniques": [
    {
      "id": "T1555",
      "name": "Credentials from Password Stores"
    },
    {
      "id": "T1555.003",
      "name": "Credentials from Web Browsers"
    },
    {
      "id": "T1539",
      "name": "Steal Web Session Cookie"
    },
    {
      "id": "T1005",
      "name": "Data from Local System"
    },
    {
      "id": "T1082",
      "name": "System Information Discovery"
    }
  ],
  "related_families": [
    "lumma"
  ],
  "sources": [
