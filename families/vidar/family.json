{
  "id": "vidar",
  "name": "Vidar",
  "classification": "known_family",
  "attribution_confidence": "high",
  "description": "Vidar Stealer logs. Build 4.x emits a flat key-colon-value\n`information.txt` opening with `Ip:`, `Country:`, `Version:`\nfollowed by hardware, locale, and build identity blocks. Vidar\nhas been distributed since 2018 as a fork of Arkei and remains a\nhigh-volume infostealer family in 2025+.",
  "aliases": [
    "VidarStealer"
  ],
  "typical_targets": [
    "Browser saved credentials, cookies, autofill, history",
    "Crypto wallet extensions and desktop clients",
    "Telegram and Discord session data",
    "FTP, email, and VPN client configurations",
    "Documents and screenshots from the desktop"
  ],
  "detection_notes": "Distinctive header trio `Ip:` + `Country:` + `Version:` at the\ntop of `information.txt`. Build banners reference the operator's\nTelegram channel.",
  "attack_techniques": [
    {
      "id": "T1555",
      "name": "Credentials from Password Stores"
    },
    {
      "id": "T1555.003",
      "name": "Credentials from Web Browsers"
    },
    {
      "id": "T1539",
      "name": "Steal Web Session Cookie"
    },
    {
      "id": "T1005",
      "name": "Data from Local System"
    },
    {
      "id": "T1082",
      "name": "System Information Discovery"
    }
  ],
  "related_families": [],
  "sources": [
